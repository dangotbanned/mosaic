{# Adapted from
https://github.com/koxudaxi/datamodel-code-generator/blob/96b4fe7768d98cd8a38eb0d942f52c1bb5d8975e/src/datamodel_code_generator/model/template/TypeAliasType.jinja2
#}
{%- macro get_type_annotation(_fields) -%}
{%- if not _fields %}
{{ base_class }}
{%- else -%}
{%- set _field = _fields[0] -%}
{%- if _field.annotated -%}
{{ _field.annotated }}
{%- elif _field.field -%}
Annotated[{{ _field.type_hint }}, {{ _field.field }}]
{%- else -%}
{{ _field.type_hint }}
{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{{ class_name }} = TypeAliasType("{{ class_name }}", {{ get_type_annotation(fields) }})
{%- if description %}
"""{{ description }}"""
{%- elif fields and fields[0].docstring %}
"""{{ fields[0].docstring }}"""
{%- endif %}